<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#CC0B1E3E" BorderBrush="#FF1C3A6E" BorderThickness="1" CornerRadius="4" Padding="16,10,16,10" Margin="0,0,0,4">
<Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
    <TextBlock FontSize="23" TextTrimming="CharacterEllipsis" MaxLines="1">$LABEL$</TextBlock>
    <TextBlock FontSize="16" Opacity="0.6" TextWrapping="Wrap">$NOTE$</TextBlock>
  </StackPanel>
  $CONTROL$
</Grid>
</Border>
