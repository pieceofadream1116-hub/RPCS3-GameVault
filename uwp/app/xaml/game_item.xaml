<ListViewItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              HorizontalContentAlignment="Stretch" Padding="8,6,8,6">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Width="120" Height="66" Background="#FF0A1A36" CornerRadius="4">
      <Grid>
        <Image x:Name="Icon" Stretch="Uniform"/>
        <TextBlock x:Name="Placeholder" FontSize="24" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center">$PLACEHOLDER$</TextBlock>
      </Grid>
    </Border>
    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock FontSize="23" TextTrimming="CharacterEllipsis" MaxLines="1">$TITLE$</TextBlock>
      <TextBlock FontSize="16" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxLines="1">$SUBTITLE$</TextBlock>
    </StackPanel>
  </Grid>
</ListViewItem>
